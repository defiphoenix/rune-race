{
  "name": "rune-race",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2"
  },
  "scripts": {
    "setup": "pnpm install",
    "dev:web": "node init && pnpm --filter @rune-race/web dev",
    "dev:admin": "node init && pnpm --filter @rune-race/admin dev",
    "dev:server": "node init && pnpm --filter @rune-race/server dev",
    "dev": "node init && node scripts/dev.mjs",
    "dev:host": "node init && node scripts/dev.mjs --host",
    "build": "node init && pnpm -r build",
    "build:web": "node init && pnpm --filter @rune-race/web build",
    "build:admin": "node init && pnpm build:shared && pnpm --filter @rune-race/admin build",
    "build:server": "node init && pnpm build:shared && pnpm build:game-engine && pnpm build:bot-ai && pnpm --filter @rune-race/server build",
    "build:render": "node init && pnpm build:shared && pnpm build:game-engine && pnpm build:bot-ai && pnpm build:server && pnpm build:web",
    "build:shared": "node init && pnpm --filter @rune-race/shared build",
    "build:game-engine": "node init && pnpm --filter @rune-race/game-engine build",
    "build:bot-ai": "node init && pnpm --filter @rune-race/bot-ai build",
    "test:bot-ai": "pnpm --filter @rune-race/bot-ai test",
    "test:game-engine": "pnpm --filter @rune-race/game-engine test",
    "test:server": "pnpm --filter @rune-race/server test",
    "type-check": "pnpm --filter @rune-race/web type-check && pnpm --filter @rune-race/admin type-check"
  }
}
